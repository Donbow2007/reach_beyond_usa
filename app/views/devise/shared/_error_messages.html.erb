<% if resource.errors.any? %>
  <div class="alert alert-danger" role="alert">
    <p class="fw-semibold mb-2"><i class="fa-solid fa-circle-exclamation me-2"></i>Please check the following:</p>
    <ul class="mb-0 ps-3">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
