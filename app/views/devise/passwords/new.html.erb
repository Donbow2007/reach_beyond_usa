<% content_for :title, "Reset password | Reach Beyond USA" %>

<section class="auth-section">
  <div class="container">
    <div class="auth-card">
      <div class="auth-card-header">
        <p class="small text-uppercase fw-bold mb-2 opacity-75">Account help</p>
        <h1 class="h2 mb-1">Reset your password</h1>
        <p class="mb-0 opacity-75">We’ll email you a secure reset link.</p>
      </div>
      <div class="auth-card-body">
        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |form| %>
          <%= render "devise/shared/error_messages", resource: resource %>
          <div class="mb-4">
            <%= form.label :email, class: "form-label fw-semibold" %>
            <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "you@example.com" %>
          </div>
          <%= form.submit "Send reset instructions", class: "btn btn-primary w-100 py-2" %>
        <% end %>
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</section>
